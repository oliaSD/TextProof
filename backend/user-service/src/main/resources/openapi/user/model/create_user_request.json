{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "Запрос на создание пользователя",
  "properties": {
    "username": {
      "type": "string",
      "description": "Имя пользоватаеля для входа",
      "example": "olga"
    },
    "password": {
      "type": "string",
      "description": "Пароль пользователя",
      "example": "password1_D"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Электронная почта пользователя",
      "example": "semernik.olga@bsuir.by"
    },
    "userRole": {
      "type": "string",
      "description": "Тип пользователя",
      "enum": [
        "USER",
        "ADMIN"
      ],
      "default": "USER"
    }
  },
  "required": [
    "username",
    "password",
    "userRole",
    "email"
  ]
}
